# Configuração do motor-consulta. Copie para ".env" (chmod 600) e ajuste.
# O .env NUNCA vai para o git (está no .gitignore).

# ============================================================================
# Perfis — quais bancos esta instalação consulta
# ============================================================================
# Um perfil = um banco. Liste os nomes (minúsculas, dígitos e _) e configure cada
# um com variáveis db_<perfil>_*. O exemplo abaixo já funciona: é o banco SQLite
# de demonstração, gerado por `python3 exemplo/criar_banco.py`.
PERFIS=loja
# Perfil usado quando nenhum é informado (padrão: o primeiro da lista).
PERFIL_PADRAO=loja
# Perfis com dado de pessoa (salário, jornada, saúde...): o servidor MCP avisa o
# modelo para trazer agregado e o painel não os libera por padrão.
PERFIS_SENSIVEIS=
# O que um acesso novo recebe no painel (padrão: todos os não sensíveis;
# "nenhum" = acesso novo nasce sem banco).
# PERFIS_INICIAIS=

# --- Banco de exemplo (SQLite) ------------------------------------------------
db_loja_engine=sqlite
# Caminho relativo vale a partir da pasta do projeto (no container, /app).
db_loja_database=exemplo/loja.db
db_loja_descricao=Loja de exemplo (dados fictícios) — clientes, produtos, pedidos e devoluções

# --- Modelos para os outros engines (descomente e ajuste) ---------------------
# Use SEMPRE um usuário só-leitura no banco: a ferramenta recusa tudo que não seja
# SELECT/WITH, mas a credencial crua não deveria poder mais do que isso.
#
# PostgreSQL
# db_vendas_engine=postgres
# db_vendas_host=10.0.0.10
# db_vendas_port=5432
# db_vendas_database=erp
# db_vendas_username=leitura
# db_vendas_password=
# db_vendas_schema=public                 # vira o search_path da sessão
# db_vendas_sslmode=                      # disable | require | verify-full ...
# db_vendas_statement_timeout_ms=180000   # teto aplicado NO servidor
# db_vendas_descricao=ERP — pedidos, notas fiscais e estoque
#
# MySQL / MariaDB
# db_chamados_engine=mysql
# db_chamados_host=10.0.0.11
# db_chamados_port=3306
# db_chamados_database=helpdesk           # obrigatório no MySQL
# db_chamados_username=leitura
# db_chamados_password=
# db_chamados_ssl=1                       # EXIGE TLS (padrão 0); use em banco remoto
# db_chamados_ssl_ca=                     # PEM para VALIDAR o certificado
# db_chamados_max_execution_ms=180000     # teto aplicado NO servidor
# db_chamados_select_limit=100000
#
# SQL Server
# db_rh_engine=sqlserver
# db_rh_host=10.0.0.12
# db_rh_port=1433
# db_rh_database=folha                    # vazio = banco padrão do login
# db_rh_username=leitura
# db_rh_password=
# db_rh_descricao=Folha de pagamento e cadastro de pessoal
#
# Oracle
# db_erp_engine=oracle
# db_erp_host=10.0.0.13
# db_erp_port=1521
# db_erp_service_name=ORCLPDB1
# db_erp_username=leitura
# db_erp_password=
# db_erp_schema=DONO_DAS_TABELAS          # CURRENT_SCHEMA da sessão (opcional)
#
# Firebird
# db_legado_engine=firebird
# db_legado_host=10.0.0.14
# db_legado_port=3050
# db_legado_database=/dados/legado.fdb    # alias do servidor ou caminho do .fdb
# db_legado_username=leitura             # evite SYSDBA: crie um usuário de leitura
# db_legado_password=
# db_legado_charset=UTF8
#
# Dois perfis no MESMO schema (ex.: usuário de leitura e usuário de BI) podem
# dividir a base de conhecimento — um dicionário e uma pasta de NOTES só:
# db_vendas_bi_banco=vendas

# --- Teto de tempo das consultas ----------------------------------------------
# Segundos; 0 = sem teto. Por perfil: db_<perfil>_query_timeout_s.
# db_query_timeout_s=180

# ============================================================================
# Servidor MCP compartilhado (docker compose up -d mcp proxy admin)
# ============================================================================
# Nome com que o servidor aparece nos clientes.
# MCP_NOME=motor-consulta

# Segredo que prova ao mcp que a requisição passou pelo proxy. OBRIGATÓRIO em
# HTTP: vazio = o mcp nega toda requisição (fail closed). Gere com:
#   openssl rand -hex 32
# Trocar o valor exige recriar os dois serviços: docker compose up -d proxy mcp
MCP_PROXY_SEGREDO=

# Endereço que os clientes usam (só aparece nos comandos prontos do painel).
# MCP_ENDPOINT=http://servidor.interno:8011/mcp

# Portas e binds publicados no host.
# MCP_PORTA_HOST=8010          # o mcp cru — sempre só em 127.0.0.1
# MCP_PROXY_BIND=127.0.0.1     # 0.0.0.0 para abrir o proxy à rede interna
# MCP_PROXY_PORTA=8011
# ADMIN_BIND=127.0.0.1         # fora do loopback, o painel EXIGE ADMIN_SENHA
# ADMIN_PORTA=8012

# Sub-rede da rede do compose. Troque se a faixa colidir com a da sua rede.
# REDE_SUBNET=172.30.99.0/24

# Fuso dos containers (horário da trilha de auditoria).
# TZ=America/Sao_Paulo

# Imagem com Oracle Instant Client (modo thick, servidor Oracle antigo).
# COM_ORACLE=0
